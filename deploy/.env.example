# Copy to deploy/.env on the VM and fill in. Never commit the real file.
#
# These override tests/TestSite/appsettings.json, which is public. The unattended install only
# reads them the first time the site boots against an empty database, so changing them here does
# not rotate an administrator that already exists: change that password in the backoffice too.
DEMO_ADMIN_EMAIL=demo@baryo.dev
DEMO_ADMIN_PASSWORD=
# Any long random string. openssl rand -base64 48
DEMO_IMAGING_HMAC_KEY=
