{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "00000000-0000-0000-0000-000000000001"
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      // Local test installs only. The public demo overrides every one of these through
      // environment variables in deploy/docker-compose.yml, which reads them from a .env file
      // that exists only on the VM. A value here must never be a credential that reaches a
      // deployed site: this file is public.
      "Unattended": {
        "InstallUnattended": true,
        "UnattendedUserName": "Test Admin",
        "UnattendedUserEmail": "test@example.com",
        "UnattendedUserPassword": "LocalTestsOnly-Not-The-Demo-4192!"
      },
      "Security": {
        "AllowConcurrentLogins": false
      },
      "Imaging": {
        "HMACSecretKey": "REVWIE9OTFkgcGxhY2Vob2xkZXIuIE5vdCBhIHNlY3JldC4gT3ZlcnJpZGUgVW1icmFjbzpDTVM6SW1hZ2luZzpITUFDU2VjcmV0S2V5IGluIHByb2R1Y3Rpb24u"
      }
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "BaryoDev": {
    "Pwa": {
      "Manifest": {
        "Name": "PWA for Umbraco (demo)",
        "ShortName": "PWA Demo",
        "StartUrl": "/",
        "ThemeColor": "#6B2D5C",
        "Icons": [
          {
            "Src": "/icon-192.png",
            "Sizes": "192x192",
            "Type": "image/png"
          },
          {
            "Src": "/icon-512.png",
            "Sizes": "512x512",
            "Type": "image/png"
          },
          {
            "Src": "/icon-512.png",
            "Sizes": "512x512",
            "Type": "image/png",
            "Purpose": "maskable"
          }
        ],
        "Description": "Demo of BaryoDev.Umbraco.Pwa: installable Umbraco with install tracking in the backoffice."
      },
      "ServiceWorker": {
        "CachePrefix": "pwademo",
        "Version": "t1"
      }
    }
  }
}
