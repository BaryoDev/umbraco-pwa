{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "00000000-0000-0000-0000-000000000001"
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "InstallUnattended": true,
        "UnattendedUserName": "Test Admin",
        "UnattendedUserEmail": "test@example.com",
        "UnattendedUserPassword": "LocalOnly-ChangeMe-1234!"
      },
      "Security": {
        "AllowConcurrentLogins": false
      },
      "Imaging": {
        "HMACSecretKey": "DEV-ONLY-PLACEHOLDER-override-in-production-see-README"
      }
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "BaryoDev": {
    "Pwa": {
      "Manifest": {
        "Name": "PWA for Umbraco (demo)",
        "ShortName": "PWA Demo",
        "ThemeColor": "#6B2D5C",
        "Icons": [
          {
            "Src": "/icon-192.png",
            "Sizes": "192x192",
            "Type": "image/png"
          },
          {
            "Src": "/icon-512.png",
            "Sizes": "512x512",
            "Type": "image/png"
          },
          {
            "Src": "/icon-512.png",
            "Sizes": "512x512",
            "Type": "image/png",
            "Purpose": "maskable"
          }
        ],
        "Description": "Demo of BaryoDev.Umbraco.Pwa: installable Umbraco with install tracking in the backoffice."
      },
      "ServiceWorker": {
        "CachePrefix": "pwademo",
        "Version": "t1"
      }
    }
  }
}
