<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Umbraco 16 runs on .NET 9; 17 and 18 run on .NET 10. Supporting all three means two
         targets, not one version range.

         15 is deliberately excluded. It is the last major with the synchronous MigrationBase,
         which 16 replaced with AsyncMigrationBase, and that break lands between 15 and 16 while
         the runtime break lands between 16 and 17. The two do not align, so one assembly cannot
         span both. 15 is also standard-term support and past its one-year window, whereas 17 is
         the current LTS and supported into late 2027. -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Maps wwwroot/ onto App_Plugins/BaryoDev.Pwa so the backoffice can find the manifest. -->
    <StaticWebAssetBasePath>App_Plugins/BaryoDev.Pwa</StaticWebAssetBasePath>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>BaryoDev.Umbraco.Pwa</PackageId>
    <Version>0.4.0</Version>
    <Authors>BaryoDev</Authors>
    <Title>PWA for Umbraco</Title>
    <Description>Turn an Umbraco site into an installable, offline-capable app, and see who installed it from the backoffice. Install prompt for Android and iOS, a network-first service worker, and install tracking that stays in your own database rather than a third-party dashboard.</Description>
    <PackageTags>umbraco;umbraco-marketplace;pwa;progressive-web-app;service-worker;offline;install</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- NuGet shows this on the package page, and without it the listing has no changelog at all.
         The Umbraco Marketplace schema has no equivalent field, so this is the only place a
         release is described to someone deciding whether to upgrade. Update it every release. -->
    <PackageReleaseNotes>Adds an optional launch_handler manifest entry, so an installed app can focus or navigate an existing window instead of opening a new one. Off unless configured, so upgrading changes nothing on its own. Concurrent install reports are now database-safe, and the dashboard summary is aggregated in SQL. Full changelog: https://github.com/BaryoDev/umbraco-pwa/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/BaryoDev/umbraco-pwa</PackageProjectUrl>
    <RepositoryUrl>https://github.com/BaryoDev/umbraco-pwa</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <!-- Brings Core, Infrastructure and the backoffice API surface transitively. The marketplace
       reads these ranges to decide which Umbraco versions the listing advertises, so between the
       two targets they need to cover every major that is actually supported. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="[16.0.0, 17.0.0)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="[17.0.0, 19.0.0)" />
  </ItemGroup>

  <!-- This package does not use System.Security.Cryptography.Xml. It pins it because Umbraco
       drags in a vulnerable version and the fix does not reach anyone who installs this.

       Umbraco.Cms.Api.Management -> Api.Common -> Web.Common -> Examine.Lucene -> Examine 3.7.1
       -> Microsoft.AspNetCore.DataProtection 8.0.4 -> System.Security.Cryptography.Xml 8.0.0 on
       net10.0, and 9.0.4 on net9.0. Both are inside the vulnerable range of eight advisories,
       seven denial of service and one signature-verification bypass (CVE-2026-47304, CVSS 8.1).

       Umbraco pinned this in their own Directory.Packages.props (PR #22514), but a central pin is
       build-internal: the published Umbraco.Cms.Examine.Lucene 17.0.0 nuspec declares only
       Examine 3.7.1, so the pin does not flow to consumers. No Examine 3.x release takes the fix
       either, and Examine 4 is Umbraco 19. So there is nothing upstream to bump, and without this
       every site installing this package resolves a vulnerable assembly.

       A direct reference here raises the floor for consumers too, which is the point. Remove it
       when Umbraco 19 support lands (#66) and Examine 4 makes it redundant. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="System.Security.Cryptography.Xml" Version="9.0.19" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
